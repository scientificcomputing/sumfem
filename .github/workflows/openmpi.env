# Open MPI settings for the jobs in DOLFINx containers. A job loads them after
# checking out the repository, without the comment lines:
#   grep -v '^#' .github/workflows/openmpi.env >> "$GITHUB_ENV"
# The containers run as root, which Open MPI refuses without these
OMPI_ALLOW_RUN_AS_ROOT=1
OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1
# The runners may have fewer cores than MPI ranks, which Open MPI 4 and 5
# refuse without these
OMPI_MCA_rmaps_base_oversubscribe=1
PRTE_MCA_rmaps_default_mapping_policy=:oversubscribe
